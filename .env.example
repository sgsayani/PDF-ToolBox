# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (optional)
# ---------------------------------------------------------------------------
# MongoDB is used for processing history and, as of Phase 6, accounts —
# registration, login, saved files and usage. Leave this unset and the API
# runs normally: PDF tools work exactly as before, history isn't recorded,
# and account endpoints return a clear "accounts unavailable" error instead
# of failing.
# MONGODB_URI=mongodb://127.0.0.1:27017/pdf-toolbox

# Signs session cookies. Required (32+ characters) once MONGODB_URI is set in
# production; in development an insecure built-in value is used if this is
# left unset, with a startup warning.
# JWT_SECRET=

# ---------------------------------------------------------------------------
# File handling
# ---------------------------------------------------------------------------
# Directory for short-lived working copies. Relative paths resolve from the
# server workspace. Its contents are purged on boot and swept on a timer.
STORAGE_DIR=.tmp/storage

# Directory for files a signed-in user has chosen to keep. Unlike STORAGE_DIR
# above, never purged or swept — a file here lives until its owner deletes it.
SAVED_STORAGE_DIR=.tmp/saved

MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=20
FILE_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=10

# ---------------------------------------------------------------------------
# Rate limiting (applies to upload and processing endpoints)
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Client (read at build time by Vite)
# ---------------------------------------------------------------------------
# Leave empty in development: the Vite dev server proxies /api to the backend.
VITE_API_BASE_URL=
